# Secretos de las Edge Functions: `supabase secrets set --env-file supabase/.env`
# Claude en Amazon Bedrock, región UE (nunca la API de Anthropic directamente).
AWS_BEARER_TOKEN_BEDROCK=
BEDROCK_REGION=eu-central-1
# Id con prefijo de perfil de inferencia UE; comprobar el id exacto en la consola de Bedrock.
BEDROCK_MODEL_COACH=eu.anthropic.claude-opus-5-5
BEDROCK_MODEL_CLASIFICADOR=eu.anthropic.claude-haiku-5-5
# Seudonimizador (services/seudonimizador en el VPS, región UE).
SEUDONIMIZADOR_URL=
SEUDONIMIZADOR_TOKEN=
# Opcional: mensajes de crisis revisados por un profesional, por país. {"ES": "...", "*": "..."}
MENSAJES_CRISIS_JSON=
INVITE_BASE_URL=
REVENUECAT_WEBHOOK_SECRET=
